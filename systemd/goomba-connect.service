[Unit]
Description=Goomba XI login server
PartOf=goomba-game.target
After=network-online.target mariadb.service goomba-world.service
Wants=network-online.target
Requires=mariadb.service
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=@USER@
Group=@USER@
WorkingDirectory=@ROOT@/server
EnvironmentFile=/etc/goomba/server.env
ExecStart=@ROOT@/server/xi_connect
Restart=always
RestartSec=5
LimitNOFILE=65535
# Hardening: /usr, /boot and /etc are read-only; home folders are hidden.
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=goomba-game.target
